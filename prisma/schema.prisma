generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  GENERATED
  REVIEW
  APPROVED
  READY
  SCHEDULED
  PUBLISHED
  FAILED
}

enum ReviewStatus {
  APPROVED
  NEEDS_REVISION
}

model Post {
  id String @id @default(cuid())

  topic          String
  format         String
  narrativeAngle String? // "BEFORE_AFTER", "HOT_TAKE", "MIGRATION_GUIDE", "SENIOR_REVIEW", "BREAKING_NEWS", "DEEP_DIVE", "COMMUNITY_PULSE", "TLDR_SUMMARY", "STEP_BY_STEP_TUTORIAL"
  caption        String?

  hashtags String[] @default([])

  status PostStatus @default(DRAFT)

  scheduledAt DateTime?
  publishedAt DateTime?

  instagramMediaId String?
  instagramUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slides  Slide[]
  logs    GenerationLog[]
  reviews ContentReview[]

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

model Slide {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  number          Int
  title           String
  text            String
  visualDirection String
  imagePath       String?

  createdAt DateTime @default(now())

  @@unique([postId, number])
  @@index([postId])
}

model GenerationLog {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  provider String
  model    String
  prompt   String

  status String
  error  String?

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([createdAt])
}

model ContentReview {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  status ReviewStatus

  score Float

  technicalAccuracy   Float
  hookQuality         Float
  structureQuality    Float
  educationalValue    Float
  engagementPotential Float
  visualConsistency   Float

  strengths   Json
  problems    Json
  suggestions Json

  summary String

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([status])
  @@index([createdAt])
}

enum InsightStatus {
  HYPOTHESIS
  VALIDATED
  REFUTED
}

enum InsightType {
  HOOK_PERFORMANCE
  FORMAT_EFFICIENCY
  TIMING_OPTIMIZATION
  AUDIENCE_PAIN
  HASHTAG_CLUSTER
  DESIGN_RETENTION
}

model PostAnalyticsAudit {
  id String @id @default(cuid())

  reportId    String?
  report      GlobalAnalyticsReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  postId      String?
  postTopic   String
  postFormat  String
  publishedAt DateTime?

  likesCount    Int @default(0)
  commentsCount Int @default(0)
  savesCount    Int @default(0)
  sharesCount   Int @default(0)
  repostsCount  Int @default(0)
  reachTotal    Int @default(0)
  impressions   Int @default(0)
  playsCount    Int @default(0)
  avgWatchTime  Float?
  totalWatchTime Float?
  trafficSources Json?

  whyItWorked       String
  whatHurtIt        String
  hookAnalysis      String
  retentionEstimate String?
  watchTimeAnalysis String?
  individualScore   Float   @default(7.0)

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([postTopic])
  @@index([createdAt])
}

model GlobalAnalyticsReport {
  id String @id @default(cuid())

  periodLabel String
  startDate   String
  endDate     String
  score       Float

  reachTotal         Int
  impressionsTotal   Int
  interactionsTotal  Int
  engagementRate     Float
  followersGained    Int
  totalPostsAnalyzed Int

  bestPerformingTopic   String
  formatPerformance     Json
  quantitativeSummary   String
  qualitativeStrengths  Json
  qualitativeWeaknesses Json
  strategicDirectives   Json
  recommendedTopics     Json

  individualPosts PostAnalyticsAudit[]

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model LearningInsightEmbedding {
  id String @id @default(cuid())

  type            InsightType
  title           String
  content         String
  embedding       Float[]
  status          InsightStatus @default(HYPOTHESIS)
  confidenceScore Float         @default(0.5)

  evidencePostsCount  Int     @default(1)
  correctionReasoning String?
  supersededById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([confidenceScore])
}

model EditorialScheduleSlot {
  id                    String    @id @default(cuid())
  dayOfWeek             String    // "Segunda-feira", "Terça-feira", etc.
  timeSlot              String    // "18:30", "12:00", etc.
  editorialPillar       String?
  format                String    // "CAROUSEL", "SINGLE_IMAGE", "REEL_SCRIPT", "STORY_PHOTO"
  narrativeAngle        String?   // "BEFORE_AFTER", "HOT_TAKE", "MIGRATION_GUIDE", "SENIOR_REVIEW", "BREAKING_NEWS", "DEEP_DIVE", "COMMUNITY_PULSE", "TLDR_SUMMARY", "STEP_BY_STEP_TUTORIAL"
  topic                 String
  objective             String    // "AUTHORITY", "VIRALITY", "EDUCATION", "ENGAGEMENT", "REACH"
  reasoning             String
  baseCopyPrompt        String?
  baseVisualPrompt      String?
  weekOffset            Int       @default(0) // 0 = Semana Atual, 1 = Proxima Semana
  status                String    @default("PLANNED") // "PLANNED", "READY", "SCHEDULED", "PUBLISHED"
  postId                String?
  pinned                Boolean   @default(false)
  isCustom              Boolean   @default(false)
  isStorySlot           Boolean   @default(false)
  interactiveStoryType  String?   // "QUIZ", "POLL", "DEV_BEHIND_THE_SCENES", "QUICK_PILL", "QUESTION_BOX", "FEED_BRIDGE"
  lastOverdueNotifiedAt DateTime?
  instagramUrl          String?
  orderIndex            Int       @default(0)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([weekOffset])
  @@index([dayOfWeek])
  @@index([status])
  @@index([postId])
}

model PendingRecommendedTopic {
  id               String   @id @default(cuid())
  topic            String
  suggestedFormat  String   @default("CAROUSEL")
  narrativeAngle   String?
  suggestedDay     String
  suggestedTime    String   @default("18:30")
  reason           String?
  baseCopyPrompt   String?
  baseVisualPrompt String?
  objective        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([suggestedDay])
  @@index([createdAt])
}

model ContentExperiment {
  id                   String    @id @default(cuid())
  originalPostId       String?
  topic                String
  editorialPillar      String?
  format               String
  targetVariable       String    // "HOOK", "BODY_DENSITY", "CTA_SAVES", "VISUAL_DESIGN"
  hypothesis           String
  previousResult       String?
  plannedPromptDiff    String?
  recommendedRecycleAt DateTime
  status               String    @default("PLANNED") // "PLANNED", "READY", "TESTED", "ARCHIVED"

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([recommendedRecycleAt])
}

model TrendingTopic {
  id               String    @id @default(cuid())
  title            String
  category         String    // "DevOps & Cloud", "Backend & Arquitetura", "Frontend & UI", "Inteligência Artificial", "Segurança & Performance", "Carreira Dev"
  summary          String
  whyTrending      String
  suggestedAngle   String
  narrativeAngle   String?   // "BEFORE_AFTER", "HOT_TAKE", "MIGRATION_GUIDE", "SENIOR_REVIEW", "BREAKING_NEWS", "DEEP_DIVE", "COMMUNITY_PULSE", "TLDR_SUMMARY", "STEP_BY_STEP_TUTORIAL"
  suggestedFormat  String    // "CAROUSEL", "REEL_SCRIPT", "SINGLE_IMAGE", "STORY_PHOTO"
  hookIdea         String
  baseCopyPrompt   String?
  baseVisualPrompt String?
  sourceLinks      String[]  @default([])
  relevanceScore   Int       @default(90) // 0 a 100
  status           String    @default("ACTIVE") // "ACTIVE", "IGNORED", "GENERATED"
  generatedPostId  String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([expiresAt])
  @@index([relevanceScore])
}

model BoostCampaign {
  id              String    @id @default(cuid())
  postId          String?
  postTopic       String
  postFormat      String?   // "CAROUSEL", "REEL_SCRIPT", "SINGLE_IMAGE", "STORY_PHOTO"
  platform        String    @default("INSTAGRAM_BOOST") // "INSTAGRAM_BOOST", "META_ADS_MANAGER"
  budgetSpent     Float     // Valor total gasto em R$ (ex: 6.00)
  currency        String    @default("BRL")
  durationDays    Int       @default(3)
  dailyBudget     Float?
  startedAt       DateTime?
  endedAt         DateTime?
  objective       String    @default("PROFILE_VISITS") // "PROFILE_VISITS", "MORE_MESSAGES", "POST_ENGAGEMENT", "WEBSITE_CLICKS"
  followersGained Int       @default(0)
  savesCount      Int       @default(0)
  profileVisits   Int       @default(0)
  reachTotal      Int       @default(0)
  impressions     Int       @default(0)
  clicksCount     Int       @default(0)
  costPerFollower Float?    // R$ por seguidor
  costPerSave     Float?    // R$ por salvamento
  costPerVisit    Float?    // R$ por visita
  targetAudience  Json?     // { age: "20-40", locations: [...], interests: [...], jobTitles: [...] }
  aiDiagnosis     String?   // Diagnóstico detalhado do Gestor de Tráfego AI
  recommendations Json?     // Lista de próximos passos recomendados
  status          String    @default("ACTIVE") // "ACTIVE", "COMPLETED", "PLANNED"
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([postId])
  @@index([createdAt])
}

model TargetAudiencePreset {
  id              String   @id @default(cuid())
  name            String   // Ex: "Devs Brasil - Clean Code & TypeScript"
  category        String   @default("GERAL") // "FULLSTACK", "BACKEND", "FRONTEND", "DEVOPS", "IA_DATA", "JUNIOR_INICIANTE"
  description     String
  objective       String   @default("PROFILE_VISITS") // "PROFILE_VISITS", "MESSAGES", "ENGAGEMENT"
  minAge          Int      @default(20)
  maxAge          Int      @default(45)
  genders         String   @default("ALL") // "ALL", "MEN", "WOMEN"
  locations       String[] @default(["Brasil"])
  interests       String[] @default([])
  jobTitles       String[] @default([])
  behaviors       String[] @default([])
  exclusions      String[] @default([])
  suggestedAction String?
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model TrafficBudgetConfig {
  id                    String    @id @default("default_budget_config")
  monthlyBudget         Float     @default(6.0) // Orçamento mensal / verba colocada (ex: R$ 6,00)
  strategyMode          String    @default("OPPORTUNISTIC") // "CONSERVATIVE", "OPPORTUNISTIC", "AGGRESSIVE"
  autoBoostEnabled      Boolean   @default(false) // Auto-Turbinar autônomo (Piloto Automático do Apolo)
  autoBoostMinScore     Int       @default(90) // Score mínimo de oportunidade para disparar auto-turbinada (ex: >= 90)
  autoBoostDailyBudget  Float     @default(6.0) // Orçamento diário para auto-turbinar (ex: R$ 6,00)
  notifyEmailOnSchedule Boolean   @default(true) // Notificar por e-mail no melhor horário e se atrasar
  currency              String    @default("BRL")
  notes                 String?
  updatedAt             DateTime  @updatedAt
}