{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "rootDir": ".",
    "outDir": "./dist-electron",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,

    "allowJs": false
  },

  "include": [
    "electron/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "electron/renderer"
  ]
}